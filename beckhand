    <!-- MEMPERBARUI BALON KATA SPEECH BUBBLE DENGAN FOTO PROFIL SVG BARU -->
    <script>
        // Modifikasi fungsi render dialogues agar memanggil generator SVG di atas
        window.renderDialogues = function(dialogues) {
            const container = document.getElementById('dialogues-container');
            container.innerHTML = "";

            dialogues.forEach(diag => {
                const isLeft = diag.side === 'left';
                
                const wrap = document.createElement('div');
                wrap.className = `flex items-start gap-3 w-full my-1.5 ${isLeft ? 'flex-row' : 'flex-row-reverse'}`;

                // Avatar Container khusus memanggil SVG Vektor Bali kustom
                const avatar = document.createElement('div');
                avatar.className = `w-14 h-14 rounded-full flex items-center justify-center shadow-md shrink-0 transition-transform hover:scale-105`;
                avatar.innerHTML = getCharacterAvatarSVG(diag.character);

                // Balon Kata
                const bubble = document.createElement('div');
                bubble.className = `speech-bubble ${isLeft ? 'bubble-left' : 'bubble-right'} p-3.5 max-w-[80%] md:max-w-[70%]`;

                const nameTag = document.createElement('div');
                nameTag.className = "text-[10px] font-black uppercase tracking-wider text-amber-900 mb-1";
                nameTag.innerText = diag.character;

                const textSpan = document.createElement('p');
                textSpan.className = "comic-font text-base md:text-lg text-slate-800 leading-snug";
                textSpan.innerText = diag.text;

                bubble.appendChild(nameTag);
                bubble.appendChild(textSpan);

                wrap.appendChild(avatar);
                wrap.appendChild(bubble);

                container.appendChild(wrap);
            });
        };

        // Fungsi kontrol membuka referensi drawer kustom
        window.toggleReferenceDrawer = function() {
            const drawer = document.getElementById("reference-drawer");
            if (drawer.classList.contains("translate-x-full")) {
                drawer.classList.remove("translate-x-full");
                synth.playBeep(400, 'triangle', 0.1, 0.15);
            } else {
                drawer.classList.add("translate-x-full");
                synth.playBeep(200, 'triangle', 0.1, 0.1);
            }
        };
    </script>
