    <!-- AUDIO SYNTHESIS CONTEXT (Suara Gamelan Virtual) -->
    <script>
        class AudioSynth {
            constructor() {
                this.ctx = null;
            }
            init() {
                if (!this.ctx) {
                    this.ctx = new (window.AudioContext || window.webkitAudioContext)();
                }
            }
            playBeep(freq, type, duration, vol) {
                this.init();
                if (this.ctx.state === 'suspended') {
                    this.ctx.resume();
                }
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = type || 'sine';
                osc.frequency.setValueAtTime(freq || 440, this.ctx.currentTime);
                gain.gain.setValueAtTime(vol || 0.1, this.ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.0001, this.ctx.currentTime + duration);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start();
                osc.stop(this.ctx.currentTime + duration);
            }
            playPageFlip() {
                this.playBeep(250, 'triangle', 0.2, 0.15);
                setTimeout(() => this.playBeep(400, 'sine', 0.15, 0.1), 60);
            }
            playClick() {
                this.playBeep(500, 'sine', 0.08, 0.12);
            }
            playSuccess() {
                const notes = [261.63, 329.63, 392.00, 523.25]; // C4, E4, G4, C5
                notes.forEach((freq, idx) => {
                    setTimeout(() => {
                        this.playBeep(freq, 'triangle', 0.3, 0.15);
                    }, idx * 100);
                });
            }
            playError() {
                this.playBeep(150, 'sawtooth', 0.4, 0.2);
            }
            playGong() {
                this.playBeep(110, 'sine', 1.8, 0.4); 
                this.playBeep(220, 'triangle', 1.4, 0.2); 
            }
        }
        const synth = new AudioSynth();

        function showToast(message, type = 'success') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = `p-4 rounded-xl shadow-lg text-sm font-bold transition-all duration-300 transform translate-y-2 opacity-0 pointer-events-auto flex items-center gap-2 border-2 border-[#3b2314] ${
                type === 'success' ? 'bg-emerald-500 text-white' : 'bg-rose-500 text-white'
            }`;
            toast.innerHTML = `<span>${type === 'success' ? '✨' : '⚠️'}</span> <span>${message}</span>`;
            container.appendChild(toast);
            
            setTimeout(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            }, 50);

            setTimeout(() => {
                toast.classList.add('translate-y-2', 'opacity-0');
                setTimeout(() => { toast.remove(); }, 300);
            }, 3000);
        }
    </script>

