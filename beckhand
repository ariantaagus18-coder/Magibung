    <!-- CODE LOGIC & BACKEND INTEGATION (FIREBASE REALTIME BACKEND) -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, doc, setDoc, collection, onSnapshot } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // Konfigurasi Database Hubungkan ke Backend Awan Firebase
        const firebaseConfig = {
            apiKey: "", // Kosongkan secara aman, sistem akan mendeteksi otomatis dan beralih ke Mode Offline Lokal
            authDomain: "megibung-edu.firebaseapp.com",
            projectId: "megibung-edu",
            storageBucket: "megibung-edu.appspot.com",
            messagingSenderId: "1234567890",
            appId: "1:1234567890:web:1234567890"
        };

        // Detektor Status Aktif Firebase
        let isFirebaseActive = false;
        let app = null;
        let db = null;
        let auth = null;

        // Inisialisasi Firebase secara aman untuk menghindari crash akibat API Key kosong
        if (firebaseConfig.apiKey && firebaseConfig.apiKey.trim() !== "") {
            try {
                app = initializeApp(firebaseConfig);
                auth = getAuth(app);
                db = getFirestore(app);
                isFirebaseActive = true;
            } catch (err) {
                console.warn("Gagal menginisialisasi Firebase SDK:", err);
            }
        }

        // State Global Sinkronisasi Real-Time
        let studentsListCache = [];

        // Hubungkan Sesi Otentikasi Anonim untuk Melacak Log Aktivitas Siswa
        async function connectBackend() {
            if (!isFirebaseActive) {
                console.log("⚠️ API Key Firebase tidak dikonfigurasi. Menggunakan Mode Offline.");
                const syncBadge = document.getElementById('sync-badge');
                if (syncBadge) {
                    syncBadge.innerHTML = "🟡 Mode Sinkron: Offline (Lokal)";
                    syncBadge.className = "bg-amber-950 border border-amber-600 text-amber-300 px-3 py-1.5 rounded-full text-[10px] font-mono font-bold";
                }
                // Muat data lokal secara aman untuk simulasi
                setupOfflineSimulators();
                return;
            }

            try {
                if (auth) {
                    await signInAnonymously(auth);
                    console.log("🟢 Koneksi Backend Berhasil!");
                    const syncBadge = document.getElementById('sync-badge');
                    if (syncBadge) {
                        syncBadge.innerHTML = "🟢 Realtime Sync: Aktif";
                        syncBadge.className = "bg-emerald-900 border border-emerald-600 text-emerald-300 px-3 py-1.5 rounded-full text-[10px] font-mono font-bold";
                    }
                    setupRealtimeListeners();
                }
            } catch (err) {
                console.warn("⚠️ Gagal menyambungkan ke awan. Mode Offline diaktifkan.", err);
                const syncBadge = document.getElementById('sync-badge');
                if (syncBadge) {
                    syncBadge.innerHTML = "🔴 Mode Sinkron: Gangguan Jaringan";
                    syncBadge.className = "bg-rose-900 border border-rose-600 text-rose-300 px-3 py-1.5 rounded-full text-[10px] font-mono font-bold";
                }
                setupOfflineSimulators();
            }
        }

        // Jalankan Koneksi saat halaman siap
        window.addEventListener('DOMContentLoaded', () => {
            connectBackend();
        });

        // Simulator Data Offline Lokal saat Firebase dinonaktifkan
        function setupOfflineSimulators() {
            // Muat hasil belajar lokal dari localStorage
            const localResults = JSON.parse(localStorage.getItem('local_student_results') || '[]');
            studentsListCache = localResults;
            renderStudentResultsTable(localResults);
        }

        // Fungsi Pembantu Render Tabel Nilai Siswa
        function renderStudentResultsTable(list) {
            const tbody = document.getElementById('student-live-tbody');
            if (!tbody) return;
            tbody.innerHTML = "";

            if (!list || list.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" class="p-4 text-center text-stone-500">Belum ada aktivitas siswa yang masuk.</td></tr>`;
                return;
            }

            list.forEach((student) => {
                const tr = document.createElement('tr');
                tr.className = "hover:bg-amber-50/50 transition-all";
                tr.innerHTML = `
                    <td class="p-3 font-bold text-amber-900">${student.name || 'Siswa'}</td>
                    <td class="p-3">Halaman ${student.currentPage || 1}</td>
                    <td class="p-3 text-center font-bold text-emerald-600">${student.solvedCount || 0} / 10</td>
                    <td class="p-3 text-center">
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold ${student.graduated ? 'bg-emerald-100 text-emerald-800 border border-emerald-300' : 'bg-amber-100 text-amber-800 border border-amber-300'}">
                            ${student.graduated ? '🏆 Lulus' : '⏳ Belajar'}
                        </span>
                    </td>
                    <td class="p-3 text-slate-500 font-mono text-[10px]">${student.timestamp || '-'}</td>
                `;
                tbody.appendChild(tr);
            });
        }

        // --- MENGHUBUNGKAN LISTENERS REALTIME ---
        function setupRealtimeListeners() {
            if (!isFirebaseActive || !db) return;

            // 1. Sinkronisasi Kustomisasi Gambar dari Guru ke Siswa secara Real-Time
            const illustrationsCol = collection(db, 'illustrations');
            onSnapshot(illustrationsCol, (snapshot) => {
                snapshot.forEach((doc) => {
                    const data = doc.data();
                    const pageNum = parseInt(doc.id.replace('page_', ''));
                    if (!isNaN(pageNum) && illustrationsState[pageNum]) {
                        illustrationsState[pageNum].gambar = data.gambar;
                        illustrationsState[pageNum].deskripsi = data.deskripsi;
                        illustrationsState[pageNum].ikon = data.ikon;
                    }
                });
                renderComicPage();
            });

            // 2. Sinkronisasi Daftar Nilai & Progress Siswa (Terbaca langsung di Panel Guru)
            const studentResultsCol = collection(db, 'student_results');
            onSnapshot(studentResultsCol, (snapshot) => {
                const tbody = document.getElementById('student-live-tbody');
                tbody.innerHTML = "";
                studentsListCache = [];

                if (snapshot.empty) {
                    tbody.innerHTML = `<tr><td colspan="5" class="p-4 text-center text-slate-500">Belum ada aktivitas siswa yang masuk.</td></tr>`;
                    return;
                }

                snapshot.forEach((doc) => {
                    const student = doc.data();
                    studentsListCache.push(student);
                });
                renderStudentResultsTable(studentsListCache);
            });
        }

        // --- MEMPERBARUI PERKEMBANGAN SISWA KE AWAN ---
        window.syncProgressToCloud = async function(isGraduated = false) {
            if (currentRole !== 'siswa') return;

            let solvedCount = 0;
            COMIC_STORY.forEach((story, idx) => {
                if (quizProgress[idx] === true) solvedCount++;
            });

            const payload = {
                name: currentUsername,
                currentPage: currentPageIdx + 1,
                solvedCount: solvedCount,
                graduated: isGraduated,
                timestamp: new Date().toLocaleTimeString()
            };

            // Selalu simpan secara lokal terlebih dahulu
            let localResults = JSON.parse(localStorage.getItem('local_student_results') || '[]');
            const existingIdx = localResults.findIndex(r => r.name === currentUsername);
            if (existingIdx > -1) {
                localResults[existingIdx] = payload;
            } else {
                localResults.push(payload);
            }
            localStorage.setItem('local_student_results', JSON.stringify(localResults));
            studentsListCache = localResults;

            // Jika offline, perbarui tampilan tabel lokal secara langsung
            if (!isFirebaseActive) {
                renderStudentResultsTable(localResults);
                return;
            }

            // Kirim data ke awan Firebase jika aktif
            try {
                const userId = auth && auth.currentUser ? auth.currentUser.uid : 'offline-user';
                const recordRef = doc(db, 'student_results', userId);
                await setDoc(recordRef, payload, { merge: true });
            } catch (err) {
                console.error("Gagal mengirim progres ke awan: ", err);
            }
        };

        // --- ADMINISTRATOR MENGUNGGAH PERUBAHAN KE AWAN ---
        window.saveCurrentPageChanges = async function() {
            const descValue = document.getElementById('admin-desc-input').value.trim();
            const emojiValue = document.getElementById('admin-emoji-input').value.trim();

            if (!descValue) {
                synth.playBeep(180, 'sawtooth', 0.3, 0.15);
                showToast("Deskripsi ilustrasi tidak boleh kosong!", "error");
                return;
            }

            // Simpan lokal terlebih dahulu
            illustrationsState[adminSelectedPageIdx].deskripsi = descValue;
            illustrationsState[adminSelectedPageIdx].ikon = emojiValue || "🌸";
            saveToLocalStorage();

            // Segera perbarui layar komik aktif jika sedang mengedit halaman yang sama
            if (currentPageIdx === adminSelectedPageIdx) {
                renderComicPage();
            }

            // Jika offline, beri tahu bahwa disimpan secara lokal
            if (!isFirebaseActive || !db) {
                synth.playSuccess();
                showToast(`Kustomisasi visual Halaman ${adminSelectedPageIdx + 1} disimpan secara lokal!`, "success");
                return;
            }

            // Unggah ke Firestore Real-Time Database jika online
            try {
                const pageDocId = `page_${adminSelectedPageIdx}`;
                const docRef = doc(db, 'illustrations', pageDocId);

                const payload = {
                    gambar: illustrationsState[adminSelectedPageIdx].gambar,
                    deskripsi: descValue,
                    ikon: emojiValue || "🌸",
                    timestamp: new Date().toLocaleTimeString()
                };

                await setDoc(docRef, payload, { merge: true });
                synth.playSuccess();
                showToast(`Kustomisasi visual Halaman ${adminSelectedPageIdx + 1} berhasil diunggah ke awan!`, "success");
            } catch (err) {
                console.error("Gagal mengunggah perubahan ke awan: ", err);
                showToast("Gagal menyimpan ke awan. Disimpan secara lokal saja.", "error");
            }
        };

        // --- EVALUASI SISWA BERBASIS AI CHAT (GEMINI CHATBOT INTEGRATION) ---
        // Mekanisme Panggilan Aman Gemini API dengan Exponential Backoff
        async function callGemini(payload) {
            const apiKey = ""; // Otomatis terpasang oleh platform runtime
            const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`;
            let delay = 1000;
            
            for (let i = 0; i < 5; i++) {
                try {
                    const response = await fetch(url, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    if (response.ok) {
                        return await response.json();
                    }
                } catch (e) {
                    // Penanganan eror teredam
                }
                await new Promise(resolve => setTimeout(resolve, delay));
                delay *= 2;
            }
            throw new Error("Kakek sedang lelah berjalan. Silakan bertanya beberapa saat lagi, ya.");
        }

        // Mengirim Chatbot Tanya Kakek Wayan AI
        window.handleSendAIChat = async function() {
            const inputEl = document.getElementById('ai-chat-input');
            const chatHistoryEl = document.getElementById('ai-chat-history');
            const loaderEl = document.getElementById('ai-chat-loading');
            const question = inputEl.value.trim();

            if (!question) return;

            // Tempelkan input chat siswa di layar
            const userMsgDiv = document.createElement('div');
            userMsgDiv.className = "text-slate-200 leading-relaxed mt-1 border-t border-emerald-800/40 pt-1.5 text-xs";
            userMsgDiv.innerHTML = `👤 <strong>Kamu:</strong> ${question}`;
            chatHistoryEl.appendChild(userMsgDiv);
            
            inputEl.value = '';
            chatHistoryEl.scrollTop = chatHistoryEl.scrollHeight;

            loaderEl.classList.remove('hidden');
            synth.playBeep(450, 'sine', 0.1, 0.1);

            // Susun instruksi pengkondisian karakter (System Prompt)
            const systemPrompt = "Kamu adalah Kakek Wayan, sesepuh adat bijaksana dari desa di Karangasem, Bali. Panggillah lawan bicaramu dengan panggilan penyayang seperti 'Cucu Kakek', 'Cucuku', 'Anakku'. Kamu berbicara dengan bahasa Indonesia yang sangat hangat, ramah, sesekali menyisipkan istilah sopan bahasa Bali (seperti 'Nggih', 'Matur Suksma', 'Mebasa Bali') dan menerjemahkannya dengan santun. Fokuslah memberikan bimbingan tentang adab Megibung, etika kemasyarakatan, keadilan porsi makan, saling asah-asih-asuh, toleransi, dan pelestarian budaya lokal di Karangasem. Jawab dengan ringkas (maksimal 3-4 kalimat).";

            const payload = {
                contents: [{
                    parts: [{ text: `Pertanyaan dari siswa bernama ${currentUsername || 'Tamu'}: ${question}` }]
                }],
                systemInstruction: {
                    parts: [{ text: systemPrompt }]
                }
            };

            try {
                const responseData = await callGemini(payload);
                const replyText = responseData.candidates?.[0]?.content?.parts?.[0]?.text || "Aduh Cucuku, Kakek agak lupa. Coba tanya lagi ya, nggih?";
                
                const aiMsgDiv = document.createElement('div');
                aiMsgDiv.className = "text-amber-300 font-medium leading-relaxed mt-1 border-t border-emerald-800/40 pt-1.5 text-xs";
                aiMsgDiv.innerHTML = `👵🏽 <strong>Kakek Wayan:</strong> ${replyText}`;
                chatHistoryEl.appendChild(aiMsgDiv);
                
                synth.playSuccess();
            } catch (err) {
                const errorMsgDiv = document.createElement('div');
                errorMsgDiv.className = "text-rose-400 font-semibold text-[10px] mt-1 italic";
                errorMsgDiv.innerHTML = `⚠️ ${err.message}`;
                chatHistoryEl.appendChild(errorMsgDiv);
                synth.playError();
            } finally {
                loaderEl.classList.add('hidden');
                chatHistoryEl.scrollTop = chatHistoryEl.scrollHeight;
            }
        };

        // Analisis Hasil Belajar Siswa Berbasis AI Guru Dashboard
        window.handleAIAnalyzeStudents = async function() {
            const loaderEl = document.getElementById('ai-evaluation-loading');
            const resultEl = document.getElementById('ai-evaluation-result');

            if (studentsListCache.length === 0) {
                showToast("Belum ada data aktivitas siswa untuk dianalisis oleh AI!", "error");
                return;
            }

            loaderEl.classList.remove('hidden');
            resultEl.classList.add('hidden');
            synth.playBeep(520, 'triangle', 0.2, 0.15);

            // Susun rekap data siswa dalam format string terstruktur
            const studentsDataString = studentsListCache.map(s => 
                `- Nama: ${s.name}, Halaman Aktif: ${s.currentPage}/10, Tantangan Terselesaikan: ${s.solvedCount}/10, Lulus: ${s.graduated ? 'Ya' : 'Belum'}`
            ).join('\n');

            const systemPrompt = "Kamu adalah Asisten Kurikulum Merdeka & Analis PjBL (Project Based Learning) Cerdas. Tugasmu adalah menganalisis data rekap kemajuan belajar siswa dalam mempelajari tradisi Megibung Karangasem. Buat laporan evaluasi singkat terstruktur dalam bahasa Indonesia yang memuat: 1) Analisis umum tingkat pemahaman kognitif siswa, 2) Perkembangan karakter sosial (Gotong Royong, Kesetaraan, Kerja Sama), dan 3) Rekomendasi konkret bagi guru untuk tindak lanjut pengajaran berbasis Discovery Learning di kelas nyata.";

            const payload = {
                contents: [{
                    parts: [{ text: `Berikut adalah data aktivitas riil siswa saat ini:\n${studentsDataString}` }]
                }],
                systemInstruction: {
                    parts: [{ text: systemPrompt }]
                }
            };

            try {
                const responseData = await callGemini(payload);
                const reportText = responseData.candidates?.[0]?.content?.parts?.[0]?.text || "Gagal menyusun ringkasan evaluasi otomatis.";
                
                resultEl.innerText = reportText;
                resultEl.classList.remove('hidden');
                resultEl.scrollTop = 0;
                synth.playSuccess();
                showToast("Analisis laporan PjBL cerdas AI berhasil disintesis!", "success");
            } catch (err) {
                resultEl.innerText = `⚠️ Terjadi kendala saat menghubungi AI: ${err.message}`;
                resultEl.classList.remove('hidden');
                synth.playError();
            } finally {
                loaderEl.classList.add('hidden');
            }
        };
    </script>

